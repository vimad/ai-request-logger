{
  "name": "ai-request-logger",
  "version": "1.0.0",
  "private": true,
  "description": "Zero-dependency reverse proxy that logs AI coding-agent API traffic, grouped into sessions, turns and provider requests.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "ai-request-logger": "./src/index.ts"
  },
  "scripts": {
    "start": "node src/index.ts",
    "start:cursor": "node src/index.ts --provider cursor",
    "start:codex": "node src/index.ts --provider codex",
    "dev": "node --watch src/index.ts",
    "dev:cursor": "node --watch src/index.ts --provider cursor",
    "dev:codex": "node --watch src/index.ts --provider codex",
    "viz": "node src/viz/server.ts",
    "dev:viz": "node --watch src/viz/server.ts",
    "typecheck": "tsc --noEmit",
    "report": "node src/core/report.ts",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^26.4.0"
  }
}
